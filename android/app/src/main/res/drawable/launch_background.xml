<?xml version="1.0" encoding="utf-8"?>
<!-- Native launch screen: matches the Flutter splash (white logo on terracotta)
     so there is no flash between the two. launch_logo.png is generated by
     tool/generate_icons_test.dart. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/tifawt_terracotta" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_logo" />
    </item>
</layer-list>
