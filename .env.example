# TIFAWT — variables for `docker compose` (copy to .env, never commit .env).
#
# The mobile app itself holds no secret: it only needs the API address at
# build time, e.g.  flutter run --dart-define=TIFAWT_API_URL=http://10.0.2.2:5000
# Without it, the app runs standalone with a simulated sync server (demo mode).

POSTGRES_PASSWORD=change-me

# Long random string: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Comma-separated web origins allowed to call the API (empty = localhost only).
CORS_ORIGINS=

# rule_based (default), openai or local — see backend/.env.example
ASSISTANT_PROVIDER=rule_based
