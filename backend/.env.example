# Copy to .env — never commit the real file.

# PostgreSQL in production, e.g. postgresql+psycopg://tifawt:secret@localhost:5432/tifawt
# Leave empty to use a local SQLite file (development).
DATABASE_URL=

# Long random string: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me

# Allowed web origins for the Flutter web build (comma separated).
# Empty = any http://localhost port (development).
CORS_ORIGINS=

# Assistant provider: rule_based (default, offline-capable), openai, or local.
ASSISTANT_PROVIDER=rule_based

# OpenAI (server side only — the key never ships in the mobile app).
OPENAI_API_KEY=
OPENAI_MODEL=

# Sovereign / self-hosted model exposing an OpenAI-compatible API.
LOCAL_LLM_URL=
LOCAL_LLM_MODEL=
